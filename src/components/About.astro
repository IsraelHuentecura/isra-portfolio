---
const skills = [
  {
    title: 'AI & Agent Architecture',
    description: 'Diseño de agentes autónomos con herramientas, context management, y reasoning multi-paso.',
    icon: '◈',
  },
  {
    title: 'Full-Stack TypeScript',
    description: 'React, Hono, Drizzle ORM, Cloudflare Workers. De la DB al pixel.',
    icon: '◉',
  },
  {
    title: 'Risk Engine Design',
    description: 'Motor de cálculo de riesgo configurable con fórmulas custom y estrategias por organización.',
    icon: '◆',
  },
  {
    title: 'Production-Grade Systems',
    description: 'Zero downtime deploys, real-time sync, observability, y sistemas que escalan.',
    icon: '◎',
  },
]
---

<section id="about" class="relative px-6 py-32 md:py-40">
  <div class="mx-auto max-w-6xl">
    <!-- Heading -->
    <div class="mb-20 max-w-3xl">
      <h2 class="font-display text-4xl leading-tight font-bold tracking-tight text-chalk md:text-5xl lg:text-6xl">
        Good software takes time
        <span class="text-peach">—</span>
        <br />
        <span class="text-stone">and working with me saves it.</span>
      </h2>
    </div>

    <!-- Skills grid -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((skill, i) => (
        <div
          class={`card-glow group rounded-2xl border border-ash/15 bg-surface-elevated p-6 delay-${i + 1}`}
        >
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-peach-glow text-xl text-peach">
            {skill.icon}
          </div>
          <h3 class="mb-2 font-display text-lg font-bold text-chalk">
            {skill.title}
          </h3>
          <p class="text-sm leading-relaxed text-stone">
            {skill.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
