---
const skills = [
  {
    title: 'AI & Agent Architecture',
    description: 'Agentes autónomos con herramientas, context management, y reasoning multi-paso.',
  },
  {
    title: 'Full-Stack TypeScript',
    description: 'React, Hono, Drizzle ORM, Cloudflare Workers. De la DB al pixel.',
  },
  {
    title: 'Risk Engine Design',
    description: 'Motor de cálculo configurable con fórmulas custom y estrategias por organización.',
  },
  {
    title: 'Production Systems',
    description: 'Real-time sync, observability, zero downtime, y sistemas que escalan.',
  },
]
---

<section id="about" class="relative px-6 py-28 md:py-36">
  <div class="mx-auto max-w-6xl">
    <div class="section-divider mb-20"></div>

    <!-- Heading -->
    <div class="mb-16 max-w-3xl">
      <h2 class="gs-reveal font-display text-[clamp(2.2rem,5vw,3.8rem)] leading-[1.05] font-bold tracking-[-0.03em] text-text">
        Good software takes time
        <span class="text-peach"> — </span>
        <span class="text-text-muted">and working with me saves it.</span>
      </h2>
    </div>

    <!-- Skills grid -->
    <div class="gs-stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((skill) => (
        <div class="card-lift rounded-2xl border border-border bg-surface/60 p-7 backdrop-blur-sm">
          <div class="mb-4 h-1 w-8 rounded-full bg-peach"></div>
          <h3 class="mb-2.5 font-display text-lg font-bold text-text">
            {skill.title}
          </h3>
          <p class="text-sm leading-relaxed text-text-muted">
            {skill.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
