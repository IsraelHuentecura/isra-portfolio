---
---

<section class="relative flex min-h-[80vh] items-center justify-center overflow-hidden px-6 py-28">
  <!-- Subtle peach gradient at bottom -->
  <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-1/3 bg-gradient-to-t from-peach/[0.06] to-transparent"></div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <h2 class="gs-reveal font-display text-[clamp(2.8rem,8vw,7.5rem)] leading-[1.05] font-bold tracking-[-0.04em] text-text-muted">
      Building systems<br />
      that make teams<br />
      <!-- "ship" with interactive pill -->
      <span id="ship-pill" class="ship-pill relative inline-block cursor-pointer">
        <span class="ship-pill-bg"></span>
        <span class="ship-pill-text-default">ship</span>
        <span class="ship-pill-text-hover">faster, safer</span>
      </span>
      and
      <!-- "scale" with dripping letters -->
      <span class="text-peach">sca<span id="drip-letters" class="drip-wrap">l</span><span id="drip-letters-2" class="drip-wrap">e</span></span>
    </h2>
  </div>
</section>

<style>
  /* === "ship" pill === */
  .ship-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: baseline;
    padding: 0.05em 0.4em;
    border-radius: 9999px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ship-pill-bg {
    position: absolute;
    inset: 0;
    background: #ffbc95;
    border-radius: inherit;
    transition: background 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  .ship-pill-text-default,
  .ship-pill-text-hover {
    position: relative;
    z-index: 1;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ship-pill-text-default {
    color: #faf6ef;
    opacity: 1;
  }

  .ship-pill-text-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.35em;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: scale(0.8);
    white-space: nowrap;
  }

  .ship-pill:hover .ship-pill-bg {
    background: #333333;
  }

  .ship-pill:hover .ship-pill-text-default {
    opacity: 0;
    transform: scale(0.7);
  }

  .ship-pill:hover .ship-pill-text-hover {
    opacity: 1;
    transform: scale(1);
  }

  /* === Dripping / melting letters === */
  .drip-wrap {
    position: relative;
    display: inline-block;
  }

  /* The drip trail — a bar that extends below the letter */
  .drip-trail {
    position: absolute;
    left: 50%;
    top: 75%;
    width: 0.12em;
    height: 0;
    transform: translateX(-50%);
    background: currentColor;
    border-radius: 0 0 999px 999px;
    opacity: 0.5;
    transition: height 1s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.6s ease;
  }

  /* Second thinner trail for depth */
  .drip-trail-thin {
    position: absolute;
    left: calc(50% + 0.08em);
    top: 75%;
    width: 0.06em;
    height: 0;
    transform: translateX(-50%);
    background: currentColor;
    border-radius: 0 0 999px 999px;
    opacity: 0.25;
    transition: height 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
                opacity 0.6s ease 0.1s;
  }

  .drip-active .drip-trail {
    height: 1.8em;
    opacity: 0.4;
  }

  .drip-active .drip-trail-thin {
    height: 1.4em;
    opacity: 0.2;
  }

  /* Drop blob at the bottom of the trail */
  .drip-blob {
    position: absolute;
    left: 50%;
    bottom: -0.08em;
    width: 0.18em;
    height: 0.18em;
    transform: translateX(-50%) scale(0);
    background: currentColor;
    border-radius: 50%;
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s,
                opacity 0.3s ease 0.6s;
  }

  .drip-active .drip-blob {
    transform: translateX(-50%) scale(1);
    opacity: 0.35;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  // Build drip elements for each letter
  document.querySelectorAll('.drip-wrap').forEach((wrap) => {
    const trail = document.createElement('span')
    trail.className = 'drip-trail'
    wrap.appendChild(trail)

    const trailThin = document.createElement('span')
    trailThin.className = 'drip-trail-thin'
    wrap.appendChild(trailThin)

    const blob = document.createElement('span')
    blob.className = 'drip-blob'
    trail.appendChild(blob)
  })

  // Trigger drip on scroll
  const dripSection = document.getElementById('drip-letters')
  if (dripSection) {
    ScrollTrigger.create({
      trigger: dripSection,
      start: 'top 75%',
      onEnter: () => {
        document.querySelectorAll('.drip-wrap').forEach((el, i) => {
          setTimeout(() => el.classList.add('drip-active'), i * 150)
        })
      },
      onLeaveBack: () => {
        document.querySelectorAll('.drip-wrap').forEach((el) => {
          el.classList.remove('drip-active')
        })
      },
    })
  }
</script>
