---
const items = [
  'TypeScript', 'React', 'Astro', 'Cloudflare Workers', 'Hono', 'Drizzle ORM',
  'GSAP', 'Zero Sync', 'AI SDK', 'Durable Objects', 'PostgreSQL', 'Tailwind',
  'Zod', 'Vitest', 'Risk Engine', 'Formula Parser', 'Lenis',
]
---

<section class="overflow-hidden border-y border-border py-6">
  <div class="ticker-track">
    {[...items, ...items].map((item) => (
      <span class="flex shrink-0 items-center gap-3 whitespace-nowrap font-mono text-sm text-text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-peach/50"></span>
        {item}
      </span>
    ))}
  </div>
</section>
