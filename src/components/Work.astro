---
const projects = [
  {
    title: 'Skyward AI',
    tag: 'Platform',
    description: 'Plataforma de compliance impulsada por IA con risk engine, ciclo de vida de controles, y agentes inteligentes. Usada por empresas en Chile y Latinoamérica.',
    tech: ['React', 'Hono', 'Cloudflare Workers', 'Zero Sync', 'Drizzle ORM'],
    accent: 'from-peach/20 to-transparent',
  },
  {
    title: 'SKY Agent',
    tag: 'AI Agent',
    description: 'Agente autónomo de GRC con 50+ herramientas, context management de 128K tokens, auto-dream memory, y reasoning multi-paso. Human-in-the-loop para mutaciones.',
    tech: ['AI SDK', 'Durable Objects', 'Tool Registry', 'GSAP Context'],
    accent: 'from-blue-400/20 to-transparent',
  },
  {
    title: 'Risk Engine',
    tag: 'Engine',
    description: 'Motor de cálculo de riesgo con fórmulas personalizables por organización. Soporta FIAES, Swiss Cheese, IEC ponderado, y estrategias custom con parser de expresiones.',
    tech: ['expr-eval', 'Zod', 'Strategy Pattern', 'Formula Parser'],
    accent: 'from-emerald-400/20 to-transparent',
  },
]
---

<section id="work" class="relative px-6 py-32 md:py-40">
  <div class="mx-auto max-w-6xl">
    <!-- Section header -->
    <div class="mb-16 flex items-end justify-between">
      <div>
        <span class="mb-3 block font-mono text-xs tracking-[0.2em] text-peach uppercase">Proyectos</span>
        <h2 class="font-display text-4xl font-bold tracking-tight text-chalk md:text-5xl">
          Work<span class="text-peach">.</span>
        </h2>
      </div>
    </div>

    <!-- Project cards -->
    <div class="space-y-6">
      {projects.map((project, i) => (
        <div
          class={`card-glow group relative overflow-hidden rounded-2xl border border-ash/15 bg-surface-elevated transition-all delay-${i + 1}`}
        >
          <!-- Gradient accent -->
          <div class={`absolute top-0 right-0 h-full w-1/3 bg-gradient-to-l ${project.accent} opacity-0 transition-opacity duration-500 group-hover:opacity-100`}></div>

          <div class="relative flex flex-col gap-6 p-8 md:flex-row md:items-start md:p-10">
            <!-- Left: info -->
            <div class="flex-1">
              <div class="mb-4 flex items-center gap-3">
                <h3 class="font-display text-2xl font-bold text-chalk md:text-3xl">
                  {project.title}
                </h3>
                <span class="rounded-full border border-ash/30 px-3 py-0.5 font-mono text-[10px] tracking-widest text-stone uppercase">
                  {project.tag}
                </span>
              </div>
              <p class="max-w-xl text-base leading-relaxed text-stone">
                {project.description}
              </p>
            </div>

            <!-- Right: tech stack -->
            <div class="flex shrink-0 flex-wrap gap-2 md:max-w-xs md:justify-end">
              {project.tech.map((t) => (
                <span class="rounded-lg bg-void px-3 py-1.5 font-mono text-[11px] text-ash">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
