---
---

<section id="hero" class="relative flex min-h-screen items-center justify-center overflow-hidden px-6">
  <!-- Floating shapes — parallax on scroll -->
  <div class="pointer-events-none absolute inset-0">
    <div class="hero-shape float-1 absolute top-[18%] left-[8%] h-20 w-36 rounded-full bg-peach/20 blur-sm"></div>
    <div class="hero-shape float-2 absolute top-[55%] right-[12%] h-28 w-28 rounded-full border-2 border-blue/20"></div>
    <div class="hero-shape float-3 absolute top-[30%] right-[22%] h-14 w-14 rotate-45 rounded-lg bg-blue/8"></div>
    <div class="hero-shape float-2 absolute bottom-[25%] left-[18%] h-36 w-36 rounded-full border border-peach/10"></div>
    <div class="hero-shape float-1 absolute top-[70%] right-[35%] h-10 w-10 rounded-full bg-peach/15"></div>
    <!-- Large ambient glow -->
    <div class="absolute top-1/2 left-1/2 h-[700px] w-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-peach/[0.04] blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-5xl text-center">
    <!-- Badge -->
    <div class="gs-reveal mb-8 inline-block">
      <span class="inline-block rounded-full border border-text-light/30 px-5 py-2 font-mono text-xs tracking-[0.15em] text-text-muted uppercase">
        Software Engineer
      </span>
    </div>

    <!-- Name — massive display type like juanmora.co -->
    <h1 class="gs-reveal font-display text-[clamp(3.5rem,12vw,9rem)] leading-[0.9] font-bold tracking-[-0.04em] text-text">
      Isra<br />
      <span class="text-peach">Huentecura</span>
    </h1>

    <!-- Tagline -->
    <p class="gs-reveal mx-auto mt-8 max-w-lg text-lg leading-relaxed text-text-muted md:text-xl">
      Building AI&#8209;powered compliance platforms
      and intelligent agents.
    </p>

    <!-- CTAs -->
    <div class="gs-reveal mt-12 flex flex-wrap items-center justify-center gap-5">
      <a
        href="#work"
        class="btn-glow group flex items-center gap-2.5 rounded-full bg-text px-7 py-3.5 font-display text-sm font-bold text-warm"
      >
        Ver proyectos
        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="#contact"
        class="rounded-full border border-text/15 px-7 py-3.5 font-display text-sm font-medium text-text transition-all hover:border-peach hover:text-peach"
      >
        Hablemos
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="gs-reveal absolute bottom-10 left-1/2 -translate-x-1/2">
    <div class="flex flex-col items-center gap-2">
      <span class="font-mono text-[10px] tracking-[0.2em] text-text-light uppercase">Scroll</span>
      <div class="h-8 w-px bg-gradient-to-b from-text-light/50 to-transparent"></div>
    </div>
  </div>
</section>
