<section id="contact" class="relative px-6 py-28 md:py-36">
  <div class="section-divider mx-auto mb-20 max-w-6xl"></div>

  <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
    <div class="h-[500px] w-[500px] rounded-full bg-peach/[0.06] blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-4xl text-center">
    <span class="gs-reveal mb-6 block font-mono text-xs tracking-[0.15em] text-peach uppercase">Contacto</span>

    <h2 class="gs-reveal font-display text-[clamp(2.5rem,7vw,5rem)] leading-[1] font-bold tracking-[-0.03em] text-text">
      Let's build something<br />
      <span class="text-peach">together.</span>
    </h2>

    <p class="gs-reveal mx-auto mt-6 max-w-md text-lg text-text-muted">
      Siempre abierto a conversar sobre nuevos proyectos, ideas de producto, o simplemente hablar de tech.
    </p>

    <div class="gs-reveal-scale mt-12">
      <a
        href="mailto:israel@skyward.ai"
        class="btn-glow group inline-flex items-center gap-3 rounded-full border border-peach/30 bg-peach/8 px-8 py-4 font-display text-lg font-bold text-peach-deep transition-all hover:bg-peach/15"
      >
