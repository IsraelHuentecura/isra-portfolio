---
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Isra Huentecura — Software Engineer' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Isra Huentecura — Software Engineer. Building AI-powered compliance platforms and intelligent agents." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-void grain">
    <slot />
  </body>
</html>
