---
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Isra Huentecura — Software Engineer' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Isra Huentecura — Software Engineer. Building AI-powered compliance platforms and intelligent agents." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-warm grain">
    <!-- Custom cursor -->
    <div id="cursor-dot" class="cursor-dot hidden md:block"></div>

    <slot />

    <script>
      import { gsap } from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'
      import Lenis from 'lenis'

      gsap.registerPlugin(ScrollTrigger)

      // ── Lenis smooth scroll ──
      const lenis = new Lenis({ lerp: 0.1, smoothWheel: true })
      lenis.on('scroll', ScrollTrigger.update)
      gsap.ticker.add((time) => lenis.raf(time * 1000))
      gsap.ticker.lagSmoothing(0)

      // ── Scroll-triggered reveals — fade up ──
      gsap.utils.toArray('.gs-reveal').forEach((el) => {
        gsap.to(el as HTMLElement, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el as HTMLElement,
            start: 'top 88%',
            once: true,
          },
        })
      })

      // ── Stagger groups ──
      gsap.utils.toArray('.gs-stagger').forEach((container) => {
        const children = (container as HTMLElement).children
        gsap.fromTo(
          children,
          { opacity: 0, y: 40 },
          {
            opacity: 1,
            y: 0,
            duration: 0.6,
            stagger: 0.08,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: container as HTMLElement,
              start: 'top 85%',
              once: true,
            },
          },
        )
      })

      // ── Scale reveals ──
      gsap.utils.toArray('.gs-reveal-scale').forEach((el) => {
        gsap.to(el as HTMLElement, {
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el as HTMLElement,
            start: 'top 88%',
            once: true,
          },
        })
      })

      // ── Left reveals ──
      gsap.utils.toArray('.gs-reveal-left').forEach((el) => {
        gsap.to(el as HTMLElement, {
          opacity: 1,
          x: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el as HTMLElement,
            start: 'top 88%',
            once: true,
          },
        })
      })

      // ── Nav background on scroll ──
      const nav = document.getElementById('nav')
      if (nav) {
        ScrollTrigger.create({
          start: 60,
          onUpdate: (self) => {
            if (self.direction === 1 && window.scrollY > 60) {
              nav.style.backgroundColor = 'rgba(250, 246, 239, 0.9)'
              nav.style.backdropFilter = 'blur(12px)'
              nav.style.borderBottom = '1px solid rgba(100,100,100,0.07)'
            } else if (window.scrollY <= 60) {
              nav.style.backgroundColor = 'transparent'
              nav.style.backdropFilter = 'none'
              nav.style.borderBottom = 'none'
            }
          },
        })
      }

      // ── Hero parallax on shapes ──
      gsap.utils.toArray('.hero-shape').forEach((el, i) => {
        gsap.to(el as HTMLElement, {
          y: -60 - i * 20,
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: 1.5,
          },
        })
      })

      // ── Drip effect on Statement section ──
      document.querySelectorAll('.drip-wrap').forEach((wrap) => {
        const trail = document.createElement('span')
        trail.className = 'drip-trail'
        wrap.appendChild(trail)

        const trailThin = document.createElement('span')
        trailThin.className = 'drip-trail-thin'
        wrap.appendChild(trailThin)

        const blob = document.createElement('span')
        blob.className = 'drip-blob'
        trail.appendChild(blob)
      })

      const dripTrigger = document.getElementById('drip-letters')
      if (dripTrigger) {
        ScrollTrigger.create({
          trigger: dripTrigger,
          start: 'top 75%',
          onEnter: () => {
            document.querySelectorAll('.drip-wrap').forEach((el, i) => {
              setTimeout(() => el.classList.add('drip-active'), i * 150)
            })
          },
          onLeaveBack: () => {
            document.querySelectorAll('.drip-wrap').forEach((el) => {
              el.classList.remove('drip-active')
            })
          },
        })
      }

      // ── Custom cursor follow ──
      const cursorDot = document.getElementById('cursor-dot')
      if (cursorDot && window.matchMedia('(pointer: fine)').matches) {
        let cx = 0, cy = 0
        document.addEventListener('mousemove', (e) => {
          cx = e.clientX
          cy = e.clientY
        })
        gsap.ticker.add(() => {
          gsap.set(cursorDot, { x: cx, y: cy })
        })

        // Hover states — grow on interactive elements
        document.querySelectorAll('a, button, .ship-pill, .card-lift').forEach((el) => {
          el.addEventListener('mouseenter', () => cursorDot.classList.add('cursor-hover'))
          el.addEventListener('mouseleave', () => cursorDot.classList.remove('cursor-hover'))
        })
      }

      // ── Magnetic buttons ──
      document.querySelectorAll('.btn-glow').forEach((btn) => {
        const el = btn as HTMLElement
        el.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = el.getBoundingClientRect()
          const x = e.clientX - rect.left - rect.width / 2
          const y = e.clientY - rect.top - rect.height / 2
          gsap.to(el, { x: x * 0.2, y: y * 0.2, duration: 0.3, ease: 'power2.out' })
        })
        el.addEventListener('mouseleave', () => {
          gsap.to(el, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.4)' })
        })
      })

      // ── Text mask reveals ──
      gsap.utils.toArray('.text-mask-inner').forEach((el) => {
        gsap.to(el as HTMLElement, {
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: (el as HTMLElement).parentElement,
            start: 'top 85%',
            once: true,
          },
        })
      })

      // ── Parallax cards ──
      gsap.utils.toArray('.card-lift').forEach((el) => {
        gsap.fromTo(
          el as HTMLElement,
          { y: 30 },
          {
            y: -30,
            ease: 'none',
            scrollTrigger: {
              trigger: el as HTMLElement,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 2,
            },
          },
        )
      })
    </script>
  </body>
</html>
